# ==============================================================================
# CareBox Family — Environment Configuration Template
# Only VITE_* public variables are accessible in the browser bundle.
# NEVER place service_role keys or private keys in this file.
# ==============================================================================

# Supabase Public API Configuration (From Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Web Push (VAPID) Public Key (Generated via: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Application Environment Mode (development | production | test)
VITE_APP_ENV=development
