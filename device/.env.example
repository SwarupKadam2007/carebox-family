# CareBox Device Mock — Environment Variables

# Supabase Edge Function endpoint (box-event)
BOX_API_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/box-event

# Device identifier (printed on the physical box)
BOX_DEVICE_TOKEN=CB-8842-PUNE

# Supabase anon key (public — safe to use in device firmware)
BOX_API_KEY=YOUR_SUPABASE_ANON_KEY

# UUID of the parent user (from the users table)
PARENT_ID=YOUR_PARENT_UUID
